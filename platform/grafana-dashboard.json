                      "spec": {
                        "query": "\r\nfrom(bucket: \"twin\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"twin_state\")\r\n  |> filter(fn: (r) =>\r\n      r._field == \"temperature\" or\r\n      r._field == \"pressure\")\r\n  |> aggregateWindow(\r\n      every: v.windowPeriod,\r\n      fn: mean,\r\n      createEmpty: false\r\n  )\r\n"
